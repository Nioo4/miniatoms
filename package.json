{
  "name": "miniatoms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:start": "supabase start",
    "db:reset:test": "node tests/integration/reset-test-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:client": "playwright test --config playwright.client.config.ts",
    "test:live": "node scripts/live.mjs",
    "test:live:local": "node scripts/live-local.mjs",
    "test:live:remote": "node scripts/live-remote.mjs",
    "test:sql": "node tests/integration/sql-smoke.mjs",
    "test:e2e:workbench": "node scripts/e2e-workbench.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "next": "16.3.5",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "type": "module"
}
